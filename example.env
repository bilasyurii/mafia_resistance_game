# Copy this file to .env and fill in your real FTP details. .env is
# git-ignored, so those values never get committed - see web/scripts/deploy.js.

FTP_HOST=ftp://your-host.example.com
FTP_PORT=21
FTP_USER=your-ftp-username
FTP_PASSWORD=your-ftp-password
# Path from the FTP login root to the folder this app's files (index.html,
# styles.css, dist/) get uploaded into. Use a DIFFERENT folder than the
# mafia_game_predictor deploy (see its own FTP_REMOTE_DIR) so the two apps
# don't overwrite each other. Only these exact files are ever uploaded -
# nothing else already in this folder is touched or deleted.
FTP_REMOTE_DIR=htdocs/resistance
